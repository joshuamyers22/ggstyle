# ggstyle: minimal (default)
#
# White panel, light grey gridlines, no spines, no tick marks. The closest
# analogue to ggplot2's theme_minimal, and the theme most people switch to
# within five minutes of meeting theme_grey.
#
# Every line here is an rcParam on purpose: anything expressible as a stylesheet
# does not belong in Python. That includes spine removal, which earlier drafts of
# the design wrongly assumed needed code.

figure.facecolor:   white
figure.edgecolor:   white
figure.figsize:     7.0, 4.33
figure.dpi:         110

axes.facecolor:     white
axes.edgecolor:     BFBFBF
axes.linewidth:     0.8
axes.grid:          True
axes.grid.axis:     both
axes.axisbelow:     True
axes.spines.top:    False
axes.spines.right:  False
axes.spines.left:   False
axes.spines.bottom: False
axes.titlesize:     12
axes.titlelocation: left
axes.titlepad:      10
axes.titlecolor:    1A1A1A
axes.labelsize:     10
axes.labelcolor:    4D4D4D
axes.labelpad:      6
axes.prop_cycle:    cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', '56B4E9', 'E69F00', '8C8C8C', '4C3B7A'])

grid.color:         D9D9D9
grid.linewidth:     0.6
grid.linestyle:     -
grid.alpha:         1.0

xtick.color:        4D4D4D
xtick.labelcolor:   4D4D4D
xtick.labelsize:    9
xtick.direction:    out
xtick.major.size:   0
xtick.minor.size:   0
xtick.major.pad:    6

ytick.color:        4D4D4D
ytick.labelcolor:   4D4D4D
ytick.labelsize:    9
ytick.direction:    out
ytick.major.size:   0
ytick.minor.size:   0
ytick.major.pad:    6

lines.linewidth:    1.5
lines.solid_capstyle: round
lines.markersize:   5

legend.frameon:     False
legend.fontsize:    9
legend.title_fontsize: 9

font.size:          10
font.family:        sans-serif
font.sans-serif:    DejaVu Sans, Helvetica Neue, Helvetica, Arial, sans-serif

savefig.dpi:        200
savefig.bbox:       tight
savefig.facecolor:  white
savefig.pad_inches: 0.1
